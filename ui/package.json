{
  "name": "tasks-desktop-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.kit.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "probe": "node probe/build.mjs",
    "web:test": "node --experimental-strip-types --test \"web/*.test.mjs\"",
    "web:check": "node --experimental-strip-types web/engine-page.mjs",
    "web:build": "vite build --mode web && node --experimental-strip-types web/pack.mjs",
    "web:e2e": "playwright test -c playwright.web.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "appkit-ui": "github:WKDSteve/appkit#v0.42.1&path:ui-kit",
    "appkit-web": "github:WKDSteve/appkit#v0.42.1&path:web-kit",
    "modern-screenshot": "4.7.0",
    "wasmoon": "1.16.0"
  }
}

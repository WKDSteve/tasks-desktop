# Rust
/target/

# Node
node_modules/
dist/

# Local, per device: never committed (data classes, tokens, vault paths)
/areas.json
/hub.json
*.local.*

# Editor / OS
.DS_Store
Thumbs.db
*.swp
# Local Claude files stay local; the shared .claude/settings.json is committed.
.claude/*
!/.claude/hooks/
!.claude/settings.json
# A local [patch] of appkit (see CLAUDE.md): never committed.
/.cargo/config.toml
__pycache__/

# The phone page, built by tools/build-mobile.py from mobile.lock (embedded by build.rs).
/ui/dist-mobile/

# What the test sheets write: pictures of a run (testing.nvim)
TESTS/sheets/out/
